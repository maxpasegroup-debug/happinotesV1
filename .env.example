# Public API origin (no path, no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://happinotes-production-6b44.up.railway.app

# Web builds only: the browser sends an `Origin` header, and the API rejects
# any origin that is not listed in its own CORS_ORIGINS variable (a request
# from an unlisted origin fails as "Cannot reach the backend"). Native Android
# and iOS builds do not send `Origin` and are unaffected. `expo start --web`
# is served through the Metro API proxy configured in metro.config.js, so it
# works without allow-listing localhost. A deployed web build must be listed
# on the backend, e.g. CORS_ORIGINS=https://happinotes.online,<web origin>.
